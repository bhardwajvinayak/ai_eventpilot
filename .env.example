# Copy this file to .env.local and fill in your own key. Never commit .env.local.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Google renames and retires models often; check the current free-tier
# model list at https://ai.google.dev/gemini-api/docs/pricing if requests fail with "model not found".
GEMINI_MODEL=gemini-3.8-flash
